# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Your Jira site URL (e.g. https://yourorg.atlassian.net)
JIRA_BASE_URL=https://tagmango-cs.atlassian.net

# Jira login email
JIRA_EMAIL=parth@tagmango.com

# Jira API token — generate at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_api_token_here

# Your Jira account ID (the reporter whose tickets are fetched)
JIRA_REPORTER_ACCOUNT_ID=712020:4c4dc397-59da-455a-b204-f08b2c25dc16
